# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string (Supabase -> Project Settings -> Database -> Connection string)
DATABASE_URL=

# Supabase project URL and anon (public) key (Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
